# Variabili gestite da Coolify (Environment Variables della Application).
# Coolify genera automaticamente SERVICE_URL_* e SERVICE_PASSWORD_* se referenziati nel compose.

POSTGRES_USER=vikunja
POSTGRES_DB=vikunja
# POSTGRES_PASSWORD → SERVICE_PASSWORD_POSTGRES (auto) o override manuale

# VIKUNJA_SERVICE_PUBLICURL → SERVICE_URL_VIKUNJA_3456 (auto dal dominio)
# VIKUNJA_SERVICE_SECRET → SERVICE_PASSWORD_VIKUNJA (auto) o override manuale

RELEASE_VERSION=dev